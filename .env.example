# ==============================================================================
# PLATAFORMA DE ANÁLISIS SÍSMICO - VARIABLES DE ENTORNO (PLANTILLA)
# Copiar este archivo a .env y ajustar valores según el entorno.
# NUNCA subir credenciales reales al repositorio.
# ==============================================================================

# Perfiles de Docker Compose activos por defecto (core: postgres, airflow, api, frontend)
# Opcionales para desarrollo de IA y catálogo: core,ai,metadata
COMPOSE_PROFILES=core

# ------------------------------------------------------------------------------
# PostgreSQL (Base de datos principal)
# ------------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5433
POSTGRES_DB=seismic_platform
POSTGRES_USER=postgres_admin
POSTGRES_PASSWORD=postgres_example_password

# Contraseñas de los roles específicos de aplicación (seguridad de privilegios mínimos)
POSTGRES_PIPELINE_PASSWORD=pipeline_example_password
POSTGRES_API_READER_PASSWORD=api_reader_example_password
POSTGRES_AI_READER_PASSWORD=ai_reader_example_password

# ------------------------------------------------------------------------------
# Apache Airflow
# ------------------------------------------------------------------------------
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=false
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://postgres_admin:postgres_example_password@postgres:5432/seismic_platform

# ------------------------------------------------------------------------------
# Parámetros del Pipeline de Ingesta (USGS)
# ------------------------------------------------------------------------------
USGS_API_BASE_URL=https://earthquake.usgs.gov/fdsnws/event/1/query
USGS_MIN_MAGNITUDE=2.5
INGEST_INTERVAL_MINUTES=15
INITIAL_LOOKBACK_DAYS=7
REQUEST_TIMEOUT_SECONDS=30
MAX_REQUEST_RETRIES=3

# ------------------------------------------------------------------------------
# Apache Spark (Configuración Local)
# ------------------------------------------------------------------------------
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=1g
SPARK_SHUFFLE_PARTITIONS=4

# ------------------------------------------------------------------------------
# FastAPI Backend
# ------------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# Inteligencia Artificial Local (Ollama)
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:1b
AI_TIMEOUT_SECONDS=45
AI_COST_PER_TOKEN=0.0
ANOMALY_ZSCORE_THRESHOLD=3.0
ANOMALY_MIN_OBSERVATIONS=24

# ------------------------------------------------------------------------------
# Frontend (React)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
